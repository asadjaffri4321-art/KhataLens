# ──────────────────────────────────────────────
# KhataLens WhatsApp Reminder — Environment Vars
# ──────────────────────────────────────────────

# Server
PORT=5000

# ── SQLite ──────────────────────────────────────
# Path to khata.db (defaults to ../khata.db relative to server/)
# DB_PATH=../khata.db

# ── Meta WhatsApp Cloud API ─────────────────────
# Get these from https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAG...your_permanent_token_here
PHONE_NUMBER_ID=123456789012345
